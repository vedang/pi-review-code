{
  "name": "pi-review-code",
  "version": "0.1.0",
  "description": "Context-rich code review extension for pi.",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": ["pi-package", "pi", "extension", "review", "code-review"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "make test",
    "test-unit": "make test-unit",
    "test-llm": "make test-llm",
    "test-integration": "make test-integration",
    "check": "make check",
    "format": "make format"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.65.2",
    "@mariozechner/pi-tui": "^0.65.2",
    "@sinclair/typebox": "^0.34.49"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@mariozechner/pi-coding-agent": "^0.65.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jscpd": "^4.0.8",
    "knip": "^5.86.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
